# Maintainer: Electronic-Mango <78230210+Electronic-Mango@users.noreply.github.com>

pkgname=proton-wineland-v3
_pkgver=11.0-20261024
pkgver=${_pkgver//-/_}
pkgrel=1
epoch=1

pkgdesc="Compatibility tool for Steam Play based on Wine with Wayland improvements and additional components"
url="https://github.com/nanomatters/proton-cachyos"
arch=(x86_64)
options=(!strip emptydirs)
license=('BSD' 'LGPL' 'zlib' 'MIT' 'MPL' 'custom')
makedepends=(rsync)
provides=('proton-wineland-v3' 'proton')
backup=("usr/share/steam/compatibilitytools.d/${pkgname}/user_settings.py")

source_x86_64=(${_pkgver}_${pkgrel}.tar.gz::${url}/releases/download/wineland-${_pkgver}/proton-wineland-${_pkgver}-x86_64_v3.tar.xz)
sha512sums_x86_64=('3430e81383a1d33ed71ec6ec8b86a841c440e16f0debc8c866a98da92fe739e5248edab141ed0f38aa858f05da1f4ea9d98c06eaa0c01471dc27aa3701eab53e')

_unpacked="proton-wineland-${_pkgver}-x86_64_v3"

build() {
    find -type f -name "*.reg" -exec sed -i 's/"LogPixels"=dword:00000060/"LogPixels"=dword:000000c0/' -- {} \;
    sed -i 's/"display_name" "proton-wineland-\(.*\)-x86_64_v3"/"display_name" "Proton Wineland \1"/' "${_unpacked}"/compatibilitytool.vdf
}

package() {
    local _compatdir="${pkgdir}/usr/share/steam/compatibilitytools.d"
    mkdir -p "${_compatdir}/${pkgname}"
    rsync --delete -arx "${_unpacked}"/* "${_compatdir}/${pkgname}"

    mkdir -p "${pkgdir}/usr/share/licenses/${pkgname}"
    mv "${_compatdir}/${pkgname}"/{PATENTS.AV1,LICENSE{,.OFL}} \
        "${pkgdir}/usr/share/licenses/${pkgname}"
}
