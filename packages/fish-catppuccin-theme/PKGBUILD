# Maintainer: Electronic-Mango <78230210+Electronic-Mango@users.noreply.github.com>

pkgname="fish-catppuccin-theme"
pkgver=r75.g5fc5ae9
pkgrel=1
pkgdesc="Soothing pastel theme for the Fish Shell"
url="https://github.com/catppuccin/fish"
license=('MIT')
arch=('any')

depends=('fish')
makedepends=('git')

source=("${pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    printf "r%s.g%s" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "${pkgname}"
    install -Dm644 themes/*.theme -t "${pkgdir}/usr/share/fish/themes/"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}/"
}
