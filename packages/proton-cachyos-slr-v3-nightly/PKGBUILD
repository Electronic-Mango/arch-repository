# Maintainer: Electronic-Mango <78230210+Electronic-Mango@users.noreply.github.com>

pkgname=proton-cachyos-slr-v3-nightly
_build_number=206
_commit_hash=gd3cb5d84
_main_pkgver='11.0-20260924'
pkgver="${_main_pkgver//-/_}_${_build_number}"
pkgrel=1
epoch=1

pkgdesc="A compatibility tool for Steam Play based on Wine and additional components, experimental branch with extra CachyOS flavour (Steam Linux Runtime build)"
url="https://github.com/CachyOS/proton-cachyos"
arch=(x86_64 x86_64_v3)
options=(!strip emptydirs)
license=('BSD' 'LGPL' 'zlib' 'MIT' 'MPL' 'custom')
makedepends=(rsync)
optdepends=(NTSYNC-MODULE)
provides=('proton-cachyos-nightly')
backup=("usr/share/steam/compatibilitytools.d/${pkgname}/user_settings.py")

_proton_artifact_id=11247510601
_checksum_artifact_id=11247545594
_proton_zip_checksum='4f2b7dcb9d17d77ac9663a082b02d5e137c8a10624afdc9299ba95847b8925b8'
_checksum_zip_checksum='70d902b5d9a33fa87395141b14ae11e14a9d3eab1a9648829c13518997b6d93d'
source=(
    "proton.zip::https://nightly.link/CachyOS/proton-cachyos/actions/artifacts/${_proton_artifact_id}.zip"
    "checksum.zip::https://nightly.link/CachyOS/proton-cachyos/actions/artifacts/${_checksum_artifact_id}.zip"
    'compatibilitytool.vdf.template'
    'ntsync.conf'
)
sha256sums=(
    "${_proton_zip_checksum}"
    "${_checksum_zip_checksum}"
    '6983622dc08784891929b843e8c5bf566c160eb2c23b7fc89c0f4dbabcd5db69'
    'c19771ae86e7df179f6b2f4a2837d3f0cbbbba7b32baef41a3c27120c760d78f'
)

_unpacked="proton-cachyos-${_main_pkgver}-base-${_build_number}-${_commit_hash}-x86_64_v3"

prepare() {
    if ! sha512sum -c "${_unpacked}.sha512sum"; then
        error "Unwrapped checksum verification failed"
        return 1
    fi
    tar xvf "${_unpacked}.tar.xz"
}

build() {
    cd "${_unpacked}"
    find -type f -name "*.reg" -exec sed -i 's/"LogPixels"=dword:00000060/"LogPixels"=dword:000000c0/' -- {} \;
    sed -r \
      -e "s|##INSTALL_PATH##|.|" \
      -e "s|##DISPLAY_NAME##|Proton CachyOS ${_main_pkgver} (nightly ${_build_number})|" \
      -e "s|##INTERNAL_TOOL_NAME##|${pkgname}|" \
      "${srcdir}/compatibilitytool.vdf.template" > compatibilitytool.vdf
}

package() {
    local _compatdir="${pkgdir}/usr/share/steam/compatibilitytools.d"
    mkdir -p "${_compatdir}/${pkgname}"
    rsync --delete -arx "${_unpacked}"/* "${_compatdir}/${pkgname}"

    mkdir -p "${pkgdir}/usr/share/licenses/${pkgname}"
    mv "${_compatdir}/${pkgname}"/{PATENTS.AV1,LICENSE{,.OFL}} \
        "${pkgdir}/usr/share/licenses/${pkgname}"

    # Load ntsync module
    install -Dm644 "$srcdir/ntsync.conf" "$pkgdir/usr/lib/modules-load.d/10-$pkgname.conf"
}